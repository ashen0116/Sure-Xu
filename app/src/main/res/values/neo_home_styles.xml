<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 首页四档切换（今日/本月/今年/累计） -->
    <style name="NeoHomeRangeTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/neo_text_hint</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 森林卡里的四个小格 -->
    <style name="NeoHomeTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:background">@drawable/neu_card_pressed</item>
    </style>

    <style name="NeoHomeTileValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/neo_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NeoHomeTileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/neo_text_hint</item>
        <item name="android:textSize">10sp</item>
    </style>

</resources>
