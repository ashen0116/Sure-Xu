<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============ 扁平卡片风格（对齐 Watermelon 参考图） ============
         参考图特征：几乎不用描边，靠「淡青绿底 + 纯白卡片」分层；
         内容用粉彩色块区分；强调是近黑药丸；大量留白。
         所有 color name 保持原样，只换取值 / 追加粉彩色，避免改动引用处。 -->

    <!-- 页面底 / 卡片 / 极淡边框 -->
    <color name="neo_base">#F3F6F5</color>
    <color name="neo_card">#FFFFFF</color>
    <color name="neo_card_edge">#E8EFEC</color>
    <color name="neo_highlight">#F7FAF9</color>
    <color name="neo_bubble_ai">#E9F2EE</color>

    <!-- 阴影占位：扁平风格不做凸起，留中性浅色供少数层叠 drawable 使用 -->
    <color name="neo_shadow">#E8EFEC</color>
    <color name="neo_shadow_deep">#DCE7E2</color>

    <!-- 次级面 / 选中面：淡青绿，对应参考图左侧栏 -->
    <color name="neo_pressed">#E9F2EE</color>
    <color name="neo_pressed_edge">#E8EFEC</color>

    <!-- 主色：沉稳蓝（进度 / 数据） -->
    <color name="neo_primary">#2563EB</color>
    <color name="neo_primary_deep">#1D4ED8</color>
    <color name="neo_primary_soft">#EFF6FF</color>

    <!-- 辅色 -->
    <color name="neo_secondary">#6366F1</color>
    <color name="neo_secondary_soft">#EEF2FF</color>

    <!-- 强调 -->
    <color name="neo_accent">#F59E0B</color>
    <color name="neo_accent_soft">#FFFBEB</color>

    <!-- 文字层级 -->
    <color name="neo_text_primary">#0F172A</color>
    <color name="neo_text_secondary">#475569</color>
    <color name="neo_text_hint">#94A3B8</color>
    <color name="neo_on_primary">#FFFFFF</color>

    <color name="neo_error">#DC2626</color>
    <color name="neo_blue">#2563EB</color>

    <!-- 底栏：纯白卡片 + 极淡边 -->
    <color name="neo_nav_float_bg">#FFFFFFFF</color>
    <color name="neo_nav_float_edge">#E8EFEC</color>
    <color name="neo_nav_item_selected">#E9F2EE</color>
    <color name="neo_nav_item_selected_edge">#DCE7E2</color>

    <!-- 光影：扁平风格基本不用，留极淡值防止旧 drawable 出现硬边 -->
    <color name="neo_shadow_soft">#080F172A</color>
    <color name="neo_shadow_outer">#040F172A</color>
    <color name="neo_highlight_soft">#00FFFFFF</color>

    <!-- 粉彩内容块：对应参考图里淡紫 / 淡蓝 / 淡黄 / 淡绿课程卡 -->
    <color name="neo_pastel_purple">#EEE9FB</color>
    <color name="neo_pastel_purple_text">#5B4BB7</color>
    <color name="neo_pastel_blue">#E5F0FC</color>
    <color name="neo_pastel_blue_text">#2563A8</color>
    <color name="neo_pastel_amber">#FBF1D9</color>
    <color name="neo_pastel_amber_text">#9A6B12</color>
    <color name="neo_pastel_mint">#E3F3E9</color>
    <color name="neo_pastel_mint_text">#2F7A55</color>
    <color name="neo_pastel_rose">#FCE9EA</color>
    <color name="neo_pastel_rose_text">#B3404A</color>

    <!-- 功能页分类图标渐变 -->
    <color name="neo_feat_base_start">#3B82F6</color>
    <color name="neo_feat_base_end">#2563EB</color>
    <color name="neo_feat_forest_start">#0EA5E9</color>
    <color name="neo_feat_forest_end">#0284C7</color>
    <color name="neo_feat_farm_start">#6366F1</color>
    <color name="neo_feat_farm_end">#4F46E5</color>
    <color name="neo_feat_village_start">#38BDF8</color>
    <color name="neo_feat_village_end">#0EA5E9</color>
    <color name="neo_feat_sport_start">#818CF8</color>
    <color name="neo_feat_sport_end">#6366F1</color>
    <color name="neo_feat_other_start">#94A3B8</color>
    <color name="neo_feat_other_end">#64748B</color>
</resources>
